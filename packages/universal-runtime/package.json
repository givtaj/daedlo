{
  "name": "@daedlo/universal-runtime",
  "version": "0.1.0-alpha.6",
  "description": "Journal-capable browser session runtime for Daedlo Universal",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.2 <25"
  },
  "exports": {
