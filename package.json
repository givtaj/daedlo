{
  "name": "daedlo-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/runtime"
  ],
  "scripts": {
    "test": "node --test packages/runtime/tests/*.test.mjs",
    "test:rust": "cargo test --workspace --locked",
    "test:e2e": "node tests/acceptance.mjs",
    "test:motion": "node --test packages/runtime/tests/motion-browser.mjs",
    "test:controls": "node --test packages/runtime/tests/control-boundary-browser.mjs",
    "test:cli": "node --test packages/runtime/tests/cli-factory-browser.mjs",
    "release": "node scripts/release/cli.mjs",
    "test:release": "node --test tests/release-*.test.mjs",
    "ninja": "node scripts/release/ninja.mjs",
    "native": "node scripts/release/native.mjs",
    "test:native": "node --test tests/release-native-*.test.mjs",
    "test:native:customer": "node tests/native-architecture-acceptance.mjs",
    "test:ninja": "node --test tests/release-ninja-*.test.mjs",
    "test:ninja:ui": "node --test tests/ninja-ui-browser.mjs",
    "test:ninja:customer": "node tests/ninja-architecture-acceptance.mjs",
    "test:release:e2e": "node tests/release-acceptance.mjs",
    "demo": "node examples/roots/serve.mjs",
    "check": "node scripts/check.mjs && npm run types && npm run format:check",
    "types": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target esnext --types node packages/runtime/src/index.d.ts",
    "format:check": "prettier --check packages/runtime/src packages/runtime/tests examples/notebook examples/starter examples/managed-starter tests/managed-starter-*.mjs tests/evidence-*.mjs tests/starter*.mjs tests/alpha4-*.mjs tests/fixtures/alpha4-upgrade tests/acceptance.mjs tests/release-*.mjs scripts/check.mjs scripts/ci-select.mjs scripts/release package.json packages/runtime/package.json examples/roots/*.mjs examples/roots/*.html examples/roots/*.css examples/roots/tests .github/workflows/*.yml",
    "demo:notebook": "node packages/runtime/src/cli.mjs --project examples/notebook/project.mjs",
    "roots:prepare": "node examples/roots/prepare-live.mjs",
    "roots:live": "node examples/roots/launch-live.mjs",
    "test:roots-example": "node --test examples/roots/tests/*.test.mjs",
    "roots:feature:prepare": "node integrations/roots/prepare-feature.mjs",
    "roots:feature:stage": "node integrations/roots/stage-feature.mjs",
    "test:roots-feature": "node integrations/roots/feature-acceptance.mjs",
    "test:viewer": "node --test packages/runtime/tests/viewer-presentation-browser.mjs packages/runtime/tests/viewer-frontend-browser.mjs packages/runtime/tests/viewer-recipe-paths-browser.mjs packages/runtime/tests/viewer-grid-browser.mjs",
    "test:starter": "node tests/starter-acceptance.mjs",
    "test:starter:unit": "node --test tests/starter-accounting.test.mjs tests/starter-installed-inventory.test.mjs",
    "test:managed-starter": "node tests/managed-starter-acceptance.mjs",
    "test:evidence": "node tests/evidence-reporting-acceptance.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "prettier": "3.6.2",
    "typescript": "6.0.3"
  }
}
